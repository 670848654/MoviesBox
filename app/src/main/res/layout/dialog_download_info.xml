<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/title"
        android:textSize="22dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="22sp"
        android:autoSizeMaxTextSize="26sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/directory"
        android:textColor="@color/defaultTextColor"
        android:drawableLeft="@drawable/round_bookmark_24"
        android:drawableTint="@color/defaultTextColor"
        android:drawablePadding="10dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:textSize="14dp"
        android:layout_marginTop="5dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/time"
        android:textColor="@color/defaultTextColor"
        android:drawableLeft="@drawable/round_more_time_24"
        android:drawableTint="@color/defaultTextColor"
        android:drawablePadding="10dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:textSize="14dp"
        android:layout_marginTop="5dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/source"
        android:textColor="@color/defaultTextColor"
        android:drawableLeft="@drawable/round_travel_explore_24"
        android:drawableTint="@color/defaultTextColor"
        android:drawablePadding="10dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:textSize="14dp"
        android:layout_marginTop="5dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/path"
        android:textColor="@color/defaultTextColor"
        android:drawableLeft="@drawable/round_snippet_folder_24"
        android:drawableTint="@color/defaultTextColor"
        android:drawablePadding="10dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:textSize="14dp"
        android:layout_marginTop="5dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/size"
        android:textColor="@color/defaultTextColor"
        android:drawableLeft="@drawable/round_topic_24"
        android:drawableTint="@color/defaultTextColor"
        android:drawablePadding="10dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:textSize="14dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/delete"
        app:strokeColor="@color/red500"
        app:iconTint="@color/red500"
        android:textColor="@color/red500"
        app:icon="@drawable/round_delete_sweep_24"
        android:text="@string/deleteAllMsg"
        style="@style/Button.OutlinedButton.Icon"
        android:layout_gravity="end"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
